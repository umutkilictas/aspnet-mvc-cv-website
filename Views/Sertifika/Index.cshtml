@using Cv_MVC.Models.Entity
@model List<Table_Sertifikalarim>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
            <section class="content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header p-2">
                                </div>
                                <div class="card-body">
                                        <div class="tab-pane" id="timeline">
                                            <div class="timeline timeline-inverse">
                                                @foreach(var x in Model)
                                                {


                                                <div>
                                                    <i class="fas fa-envelope bg-primary"></i>

                                                    <div class="timeline-item">
                                                        <div class="timeline-body">
                                                            @x.Aciklama
                                                        </div>
                                                        <div class="timeline-footer">
                                                            <a href="/sertifika/sertifikaGetir/@x.ID" class="btn btn-primary btn-sm">Duzenle</a>
                                                            <a href="/sertifika/sertifikaSil/@x.ID" class="btn btn-danger btn-sm">Sil</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                }
                                            </div>
                                            <a href="/sertifika/sertifikaEkle" class="btn btn-info">Yeni Sertifika Ekle</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </section>
</body>
</html>


