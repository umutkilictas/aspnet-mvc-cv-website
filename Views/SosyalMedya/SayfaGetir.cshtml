@model Cv_MVC.Models.Entity.Table_SosyalMedya

@{
    ViewBag.Title = "SayfaGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Sosyal Medya Hesap Guncelle</h4>
<br />
<form method="post">
    @Html.Label("Sosyal Medya Adi")
    @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
    <br />
    @Html.Label("Hesap Linki")
    @Html.TextBoxFor(x => x.Link, new { @class = "form-control" })
    <br />
    @Html.Label("Ikon Class")
    @Html.TextBoxFor(x => x.Ikon, new { @class = "form-control" })
    <br />
    <button class="btn btn-success">Guncelle</button>
</form>

