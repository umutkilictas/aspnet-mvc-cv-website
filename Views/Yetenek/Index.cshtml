@using Cv_MVC.Models.Entity
@model List<Table_Yeteneklerim>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{ string color = "";
    string labelColor = "";
    }


<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-12">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Yetenek Listem</h3>
              </div>
              <div class="card-body">
                  <a href="/Yetenek/YeniYetenek" class="btn btn-info">Yeni Yetenek Ekle</a>
                  <br />
                  <br />
                  <table class="table table-bordered">
                      <thead>
                          <tr>
                              <th style="width: 10px">#</th>
                              <th>Yetenek</th>
                              <th>Derece</th>
                              <th style="width: 40px">Oran</th>
                              <th>Guncelle</th>
                              <th>Sil</th>
                          </tr>
                      </thead>
                      <tbody>
                          @foreach (var x in Model)
                          {
                              if (x.Oran >= 0 && x.Oran <= 50)
                              {
                                  color = "progress-bar bg-danger";
                                  labelColor = "badge bg-danger";
                              }
                              if (x.Oran >= 51 && x.Oran <= 70)
                              {
                                  color = "progress-bar bg-warning";
                                  labelColor = "badge bg-warning";
                              }
                              if (x.Oran >= 71 && x.Oran <= 84)
                              {
                                  color = "progress-bar bg-primary";
                                  labelColor = "badge bg-primary";
                              }
                              if (x.Oran >= 85 && x.Oran <= 100)
                              {
                                  color = "progress-bar bg-success";
                                  labelColor = "badge bg-success";
                              }
                              <tr>
                                  <td>@x.ID</td>
                                  <td class="w-50">@x.Yetenek</td>
                                  <td>
                                      <div class="progress progress-xs">
                                          <div class="@color" style="width: @x.Oran%"></div>
                                      </div>
                                  </td>
                                  <td><span class="@labelColor">@x.Oran%</span></td>
                                  <td>
                                      <a href="/Yetenek/YetenekGuncelle/@x.ID" class="btn btn-info btn-sm"><i class="fas fa-pencil-alt"></i>Guncelle</a>
                                  </td>
                                  <td>
                                      <a href="/Yetenek/YetenekSil/@x.ID" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i>Sil</a>
                                  </td>
                              </tr>
                          }
                      </tbody>
                  </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</body>
</html>


